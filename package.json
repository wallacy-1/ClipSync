{
  "name": "clipsync",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 all",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 windows",
    "release:android": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 android",
    "release:android-key": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 android-key"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-barcode-scanner": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
